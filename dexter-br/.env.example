# === LLM (obrigatório) ===
# Chave da API Anthropic (Claude). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo Claude (opcional; default definido em src/config.ts)
# DEXTER_MODEL=claude-opus-4-8

# === Camada macro: brazil-agent (bridge MCP) ===
# Caminho ABSOLUTO para o repositório brazil-agent (data-dev), onde ficam os
# servidores MCP em Python (mcp_servers/). O Dexter BR sobe esses servidores.
# Ex (Windows): C:\Users\DELL\Documents\data-dev
# Ex (Linux):   /workspace/brazil-agent
BRAZIL_AGENT_PATH=

# Comando Python usado para rodar os servidores MCP (default: python3)
# DEXTER_PYTHON=python3

# Chave FRED (opcional) — usada pelo servidor global_macro do brazil-agent
# FRED_API_KEY=

# === Camada de ações B3 (brapi.dev) ===
# Token brapi.dev (opcional; sem token há limite menor de requisições).
# Usado por ações (cotação/fundamentos/screening) e cointegração de pares.
# https://brapi.dev/
BRAPI_TOKEN=

# === Painel de KPIs (API REST do brazil-agent) ===
# URL da API FastAPI do brazil-agent. Rode nela: `python api_server.py`.
# Só ativa as tools de painel se /api/v1/health responder.
# DEXTER_MACRO_API=http://localhost:8000

# === Web search (opcional) ===
# Defina UMA das duas para ativar a tool 'busca_web'.
# TAVILY_API_KEY=
# EXA_API_KEY=
